/* BookReader — visual design.
 *
 * Colours come from Textual's theme variables ($foreground, $background,
 * $surface, $panel, $boost, $primary, $accent, $foreground-muted, …).
 * Each registered theme in `app.py` supplies its own values so this file
 * stays per-theme-free.
 *
 * Per tui-design:
 *   - Reading column ≤ 84 cells (optimum reading measure).
 *   - Focused-panel border tints to `$accent`.
 *   - Quiet borders by default ($boost), accent only for focus.
 *   - No double-line borders; no decoration for decoration's sake.
 */

Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
}

#content {
    layout: horizontal;
    height: 1fr;
}

#toc {
    width: 30;
    min-width: 24;
    max-width: 42;
    padding: 1 2;
    background: $panel;
    color: $foreground;
    border-right: solid $boost;
}

#toc.-hidden {
    display: none;
}

#toc:focus-within {
    border-right: solid $accent;
}

#reader {
    width: 1fr;
    padding: 1 2;
    background: $background;
    color: $foreground;
    align-horizontal: center;
}

/* Centered, width-capped reading column. 100% on narrow terminals,
 * capped at 84 cells on wide ones. */
#reading-column {
    width: 100%;
    max-width: 84;
    height: auto;
    margin: 1 0 2 0;
    padding: 0 2;
}

/* In two-page mode the column carries two pages + a gutter, so the
 * single-column cap (84) is too tight. 140 cells → ~68 per page +
 * gutter, well inside an optimum reading measure for each side. */
#reading-column.-paged {
    max-width: 140;
}

ChapterView {
    width: 100%;
    height: auto;
}

PagedView {
    width: 100%;
    height: 1fr;
}

ChapterView.-hidden, PagedView.-hidden {
    display: none;
}

StatusBar {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $foreground-muted;
}

/* ---------- Library screen ---------- */

#library-content {
    layout: horizontal;
    height: 1fr;
}

#library-sidebar {
    width: 28;
    min-width: 22;
    max-width: 38;
    padding: 1 1;
    background: $panel;
    color: $foreground;
    border-right: solid $boost;
}

#library-sidebar:focus-within {
    border-right: solid $accent;
}

#library-table {
    width: 1fr;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

#library-status {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $foreground-muted;
}

/* ---------- Add-book modal ---------- */

_AddBookPrompt {
    align: center middle;
}
_AddBookPrompt > Static {
    margin-bottom: 1;
    color: $foreground;
}
#add-prompt-input {
    width: 60;
}
#add-prompt-buttons {
    height: 3;
    align: center middle;
}
#add-prompt-buttons Button {
    margin: 0 1;
}

/* ---------- Add-wishlist modal ---------- */

_AddWishlistPrompt {
    align: center middle;
}
_AddWishlistPrompt > Static {
    margin-bottom: 1;
    color: $foreground;
}
#wishlist-title, #wishlist-author {
    width: 60;
    margin-bottom: 1;
}
#wishlist-prompt-buttons {
    height: 3;
    align: center middle;
}
#wishlist-prompt-buttons Button {
    margin: 0 1;
}

/* ---------- Bookmark prompt ---------- */

_BookmarkNotePrompt {
    align: center middle;
}
_BookmarkNotePrompt > Static {
    margin-bottom: 1;
    color: $foreground;
}
#bookmark-prompt-input {
    width: 60;
}
#bookmark-prompt-buttons {
    height: 3;
    align: center middle;
}
#bookmark-prompt-buttons Button {
    margin: 0 1;
}

/* ---------- Bookmarks screen ---------- */

BookmarksScreen {
    align: center middle;
}
#bookmarks-list {
    width: 80;
    height: 70%;
    background: $surface;
    border: solid $boost;
}
#bookmarks-empty {
    padding: 2 4;
    color: $foreground-muted;
}
